enum InventoryAdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
  CANCELLED

  @@map("inventory_adjustment_status")
}

/// Signed direction for adjustment lines. Quantity itself remains positive.
enum InventoryAdjustmentDirection {
  IN
  OUT

  @@map("inventory_adjustment_direction")
}

/// Stock count type (Phase 3.13).
enum StockCountType {
  FULL
  CYCLE

  @@map("stock_count_type")
}

/// StockCount lifecycle (Phase 3.13).
enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  RECOUNT_REQUIRED
  APPROVED
  POSTED
  REJECTED
  CANCELLED


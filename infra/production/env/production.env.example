# =============================================================================
# Hector production environment template
# Copy to a secure location (never commit real values):
#   cp infra/production/env/production.env.example infra/production/env/production.env
# =============================================================================

# --- Deployment mode (REQUIRED for production scripts) ---
# dedicated    = containerized Nginx on 80/443 (P.2 dedicated server)
# shared-host  = host Nginx + loopback Web/API (P.2.1 shared Ubuntu server)
DEPLOYMENT_MODE=shared-host

# Compose project name (scripts default: hector for shared-host, hector-production for dedicated)
# HECTOR_COMPOSE_PROJECT=hector

# --- Image / deploy identity ---
# Prefer Git SHA or release tag. Avoid relying solely on "latest".
# Prefer prebuilt images on shared hosts: HECTOR_SKIP_BUILD=1
HECTOR_IMAGE_TAG=REPLACE_WITH_GIT_SHA
HECTOR_API_IMAGE=hector-api:${HECTOR_IMAGE_TAG}
HECTOR_WEB_IMAGE=hector-web:${HECTOR_IMAGE_TAG}
# Built from apps/api/Dockerfile --target migrator (prisma CLI + migrations)
HECTOR_MIGRATE_IMAGE=hector-api-migrate:${HECTOR_IMAGE_TAG}

# Domains (public)
HECTOR_WEB_DOMAIN=hector.pishete.com
HECTOR_API_DOMAIN=core-hector.pishete.com
HECTOR_WEB_PUBLIC_URL=https://hector.pishete.com
HECTOR_API_PUBLIC_URL=https://core-hector.pishete.com

# Build-time only (baked into Web image browser bundle)
NEXT_PUBLIC_API_URL=https://core-hector.pishete.com

# --- Dedicated mode: containerized Nginx publish ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Shared-host mode: loopback-only bindings (never 0.0.0.0) ---
HECTOR_WEB_BIND_IP=127.0.0.1
HECTOR_WEB_HOST_PORT=3100
HECTOR_API_BIND_IP=127.0.0.1
HECTOR_API_HOST_PORT=3101

# Conservative resource ceilings for 4GB shared host (~1.5GiB Hector budget)
HECTOR_API_MEM_LIMIT=512m
HECTOR_WEB_MEM_LIMIT=512m
HECTOR_POSTGRES_MEM_LIMIT=512m
HECTOR_API_CPUS=0.50
HECTOR_WEB_CPUS=0.50
HECTOR_POSTGRES_CPUS=0.50

# Preflight thresholds (Linux host)
HECTOR_PREFLIGHT_MIN_DISK_GB=5
HECTOR_PREFLIGHT_MIN_RAM_MB=1024

# --- Application ---
NODE_ENV=production
TZ=UTC
API_PORT=3001
WEB_PORT=3000
CORS_ORIGINS=https://hector.pishete.com
SWAGGER_ENABLED=false
LOG_LEVEL=info

# Auth (secrets — generate independently; never reuse across purposes)
#   openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48_ACCESS
# Independent HMAC pepper for opaque refresh-token hashes (NOT a JWT secret)
AUTH_REFRESH_PEPPER=REPLACE_WITH_OPENSSL_RAND_BASE64_48_REFRESH
JWT_ACCESS_TTL=15m
AUTH_SESSION_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=hector_refresh
# Never set DEV_SEED_PASSWORD in production

# --- PostgreSQL (not publicly exposed) ---
POSTGRES_DB=hector
POSTGRES_USER=hector_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# Optional admin user for migrations / ops (least privilege preferred)
POSTGRES_ADMIN_USER=hector_migrator
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_MIGRATOR_PASSWORD

# Runtime app connection (least privilege role)
DATABASE_URL=postgresql://hector_app:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/hector

# Migration job connection (may match admin if grants require it)
DATABASE_URL_MIGRATE=postgresql://hector_migrator:REPLACE_WITH_STRONG_MIGRATOR_PASSWORD@postgres:5432/hector

# Explicit confirmation for production-targeted scripts
# Set to the literal string "I_UNDERSTAND_PRODUCTION" only on the real server.
HECTOR_PRODUCTION_CONFIRM=

# Backup readiness gate (PR-001). Must be "verified" before real migrate+deploy.
# Set only after: successful pg_dump + off-server copy + restore-verify evidence.
HECTOR_BACKUP_GATE=unverified

# --- Backup (PR-001 / P.4) ---
# Local store (mode 0700). Never put DB passwords on the shell history.
HECTOR_BACKUP_DIR=/var/backups/hector
HECTOR_BACKUP_KEEP_DAILY=7
HECTOR_BACKUP_KEEP_WEEKLY=4
HECTOR_BACKUP_CRON_SCHEDULE=0 3 * * *
# Off-server destination (one required for gate PASS). Prefer rsync over SSH or S3-compatible push.
# Example rsync: user@backup-host:/backups/hector/
# HECTOR_BACKUP_OFFSITE_RSYNC=
# Or custom command receiving dump + meta paths as $1 $2:
# HECTOR_BACKUP_OFFSITE_CMD=
# Evidence from restore-verify.sh
# HECTOR_BACKUP_EVIDENCE_DIR=/var/backups/hector/evidence

# --- First admin bootstrap (PR-003) — set only at bootstrap time; unset after ---
# Do not commit real values. Generate password: openssl rand -base64 24
# HECTOR_BOOTSTRAP_ADMIN_EMAIL=
# HECTOR_BOOTSTRAP_ADMIN_PASSWORD=
# HECTOR_BOOTSTRAP_COMPANY_NAME=Pishteh
# HECTOR_BOOTSTRAP_COMPANY_SLUG=pishteh
# HECTOR_BOOTSTRAP_ADMIN_FIRST_NAME=
# HECTOR_BOOTSTRAP_ADMIN_LAST_NAME=
# HECTOR_BOOTSTRAP_ALLOW_PASSWORD_RESET=

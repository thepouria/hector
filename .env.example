NODE_ENV=development

WEB_PORT=3000
API_PORT=3001

# Frontend → API (browser-visible)
NEXT_PUBLIC_API_URL=http://localhost:3001

CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
LOG_LEVEL=debug

POSTGRES_DB=hector
POSTGRES_USER=hector
POSTGRES_PASSWORD=hector_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://hector:hector_dev_password@localhost:5432/hector

# Auth (development example secrets — never use in production)
JWT_ACCESS_SECRET=dev-only-hector-jwt-access-secret-change-me-32chars
JWT_ACCESS_TTL=15m
AUTH_SESSION_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=hector_refresh

# Development seed login password for *@hector.local users (never for production)
DEV_SEED_PASSWORD=HectorDevPassword1

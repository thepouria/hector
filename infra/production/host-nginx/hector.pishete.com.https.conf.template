# Enable AFTER Let's Encrypt (or equivalent) certs exist for hector.pishete.com.
# Copy to sites-available and include from the HTTP site or as a sibling file.
# Requires map $http_upgrade $connection_upgrade in http{} (common on Ubuntu nginx).
#
# Do NOT enable while certificate files are missing — nginx -t will fail.

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name hector.pishete.com;

  ssl_certificate     /etc/letsencrypt/live/hector.pishete.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/hector.pishete.com/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # Enable HSTS only after HTTPS is verified end-to-end.
  # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;

  client_max_body_size 25m;

  location / {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
}

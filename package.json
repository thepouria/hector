{
  "name": "hector",
  "version": "0.0.0",
  "private": true,
  "description": "Hector — Business Operating System",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@hector/web --filter=@hector/api",
    "dev:web": "pnpm --filter @hector/web dev",
    "dev:api": "pnpm --filter @hector/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=@hector/api --filter=@hector/web",
    "test:e2e": "pnpm --filter @hector/api test:e2e",
    "test:security": "pnpm --filter @hector/api test:security",
    "security:secrets": "docker run --rm -v \"$PWD:/path\" zricethezav/gitleaks:v8.21.2 detect --source=/path --config=/path/gitleaks.toml --redact -v",
    "security:audit": "pnpm audit --audit-level=critical",
    "security:audit:report": "pnpm audit --audit-level=high",
    "security:compose": "docker compose -f infra/production/compose.yaml --env-file infra/production/env/smoke.env config --quiet && docker compose -p hector -f infra/production/compose.shared-host.yaml --env-file infra/production/env/smoke.shared-host.env config --quiet",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @hector/database db:generate",
    "db:migrate": "pnpm --filter @hector/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @hector/database db:migrate:deploy",
    "db:seed": "pnpm --filter @hector/database db:seed",
    "db:bootstrap:production": "pnpm --filter @hector/database exec tsx scripts/production-bootstrap.ts",
    "db:studio": "pnpm --filter @hector/database db:studio",
    "db:check:catalog": "pnpm --filter @hector/database exec tsx scripts/catalog-integrity-check.ts",
    "db:check:purchasing": "pnpm --filter @hector/database exec tsx scripts/purchasing-integrity-check.ts",
    "db:check:warehouse": "pnpm --filter @hector/database exec tsx scripts/warehouse-integrity-check.ts",
    "db:check:inventory": "pnpm --filter @hector/database exec tsx scripts/inventory-integrity-check.ts",
    "db:check:valuation": "pnpm --filter @hector/database exec tsx scripts/valuation-integrity-check.ts",
    "db:check:finance": "pnpm --filter @hector/database exec tsx scripts/finance-integrity-check.ts",
    "finance:integrity": "pnpm db:check:finance",
    "db:check:sales": "pnpm --filter @hector/database exec tsx scripts/sales-integrity-check.ts",
    "sales:integrity": "pnpm db:check:sales",
    "db:check:party": "pnpm --filter @hector/database exec tsx scripts/party-integrity-check.ts",
    "party:integrity": "pnpm db:check:party",
    "db:check:settlement": "pnpm --filter @hector/database exec tsx scripts/settlement-integrity-check.ts",
    "settlement:integrity": "pnpm db:check:settlement",
    "db:check:reconciliation": "pnpm --filter @hector/database exec tsx scripts/reconciliation-integrity-check.ts",
    "reconciliation:integrity": "pnpm db:check:reconciliation",
    "db:check:phase6": "pnpm --filter @hector/database exec tsx scripts/phase6-integrity-check.ts",
    "phase6:integrity": "pnpm db:check:phase6",
    "inventory:integrity": "pnpm db:check:inventory",
    "valuation:integrity": "pnpm db:check:valuation",
    "catalog:integrity": "pnpm db:check:catalog",
    "purchasing:integrity": "pnpm db:check:purchasing",
    "warehouse:integrity": "pnpm db:check:warehouse",
    "integrity:all": "pnpm --filter @hector/database exec tsx scripts/run-all-integrity.ts",
    "ci:verify": "pnpm db:generate && pnpm typecheck && pnpm lint && pnpm test && pnpm test:security && pnpm test:e2e && pnpm integrity:all && pnpm build",
    "finance:reconcile": "pnpm finance:integrity && pnpm settlement:integrity && pnpm reconciliation:integrity",
    "party:migrate": "pnpm --filter @hector/database exec tsx scripts/party-migrate.ts",
    "party:reconcile": "pnpm --filter @hector/database exec tsx scripts/party-reconcile.ts",
    "db:rebuild:inventory-balances": "pnpm --filter @hector/database exec tsx scripts/rebuild-inventory-balances.ts",
    "inventory:reconcile": "pnpm --filter @hector/database exec tsx scripts/inventory-reconcile.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}

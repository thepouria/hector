}

/// Warehouse physical execution of an approved PurchaseReturn (Phase 3.14).
/// DRAFT has no Ledger effect. DISPATCHED posts RETURN_OUT. No READY state —
/// allocation is edited in DRAFT; dispatch is the sole inventory-critical command.
enum SupplierReturnExecutionStatus {
  DRAFT
  DISPATCHED
  CANCELLED

  @@map("supplier_return_execution_status")
}

/// Append-only inventory ledger movement types (Phase 3.9+).

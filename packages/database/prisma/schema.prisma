model Loan {
  id                        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                 String                  @map("company_id") @db.Uuid
  number                    String
  lenderType                FinanceCounterpartyType @map("lender_type")
  lenderId                  String?                 @map("lender_id") @db.Uuid
  lenderName                String                  @map("lender_name")
  currency                  CurrencyCode
  /// Agreed ceiling — not the same as received principal.
  contractedPrincipal       Decimal                 @map("contracted_principal") @db.Decimal(24, 6)
  /// Optional reference FX for foreign-currency loans (display/reporting; never revalues principal).
  referenceFxRate           Decimal?                @map("reference_fx_rate") @db.Decimal(24, 8)
  referenceFxBaseCurrency   CurrencyCode?           @map("reference_fx_base_currency")
  referenceFxQuoteCurrency  CurrencyCode?           @map("reference_fx_quote_currency")
  dueDate                   DateTime?               @map("due_date") @db.Timestamptz(3)
  interestRate              Decimal?                @map("interest_rate") @db.Decimal(24, 8)
  interestNotes             String?                 @map("interest_notes")
  feeAmount                 Decimal?                @map("fee_amount") @db.Decimal(24, 6)
  notes                     String?
  reference                 String?
  status                    LoanStatus              @default(DRAFT)
  /// Default receiving account hint; each disbursement carries its own accountId.
  receivingAccountId        String?                 @map("receiving_account_id") @db.Uuid
  requestId                 String?                 @map("request_id") @db.Uuid
  createdById               String                  @map("created_by_id") @db.Uuid
  postedAt                  DateTime?               @map("posted_at") @db.Timestamptz(3)
  postedById                String?                 @map("posted_by_id") @db.Uuid
  cancelledAt               DateTime?               @map("cancelled_at") @db.Timestamptz(3)
  cancelledById             String?                 @map("cancelled_by_id") @db.Uuid
  reversedAt                DateTime?               @map("reversed_at") @db.Timestamptz(3)
  reversedById              String?                 @map("reversed_by_id") @db.Uuid
  settledAt                 DateTime?               @map("settled_at") @db.Timestamptz(3)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  receivingAccount FinancialAccount? @relation("LoanReceivingAccount", fields: [receivingAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy        User              @relation("LoanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy         User?             @relation("LoanPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy      User?             @relation("LoanCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  reversedBy       User?             @relation("LoanReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  disbursements    LoanDisbursement[]
  repayments       LoanRepayment[]

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, currency, createdAt])
  @@index([companyId, dueDate])
  @@index([companyId, requestId])
  @@map("loans")
}


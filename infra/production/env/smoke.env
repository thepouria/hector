# Disposable local smoke environment — NOT production.
# Safe to commit: values are local-only placeholders that pass production Zod checks.
# Dedicated (containerized Nginx) profile.

DEPLOYMENT_MODE=dedicated
HECTOR_COMPOSE_PROJECT=hector-smoke

HECTOR_IMAGE_TAG=smoke-local
HECTOR_API_IMAGE=hector-api:smoke-local
HECTOR_WEB_IMAGE=hector-web:smoke-local
HECTOR_MIGRATE_IMAGE=hector-api-migrate:smoke-local

HECTOR_WEB_DOMAIN=hector.pishete.com
HECTOR_API_DOMAIN=core-hector.pishete.com
HECTOR_WEB_PUBLIC_URL=https://hector.pishete.com
HECTOR_API_PUBLIC_URL=https://core-hector.pishete.com
NEXT_PUBLIC_API_URL=https://core-hector.pishete.com

NGINX_HTTP_PORT=18080
NGINX_HTTPS_PORT=18443

NODE_ENV=production
TZ=UTC
API_PORT=3001
WEB_PORT=3000
CORS_ORIGINS=https://hector.pishete.com
SWAGGER_ENABLED=false
LOG_LEVEL=info


  @@unique([id, companyId])
  @@unique([companyId, sourceType, sourceId, type])
  @@index([companyId, payableId, createdAt])
  @@index([companyId, supplierId, currency])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, requestId])

// Hector foundation schema — Phase 0.2
// Naming: Prisma camelCase models/fields; PostgreSQL snake_case via @@map/@map.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  runtime       = "nodejs"
  moduleFormat  = "cjs"
  // Empty extension keeps Nest/CommonJS require resolution simple after tsc emit.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED

  @@map("company_status")
}

enum CompanyMemberStatus {
  ACTIVE
  SUSPENDED
  /// Access removed while preserving historical membership identity.
  REMOVED

  @@map("company_member_status")
}

/// Company base currency only. Full multi-currency finance belongs to a later phase.
/// Purchase Order lifecycle (Phase 2.4). Receiving/closed states arrive with Warehouse (later phases).
/// Purchase Order lifecycle (Phase 2.9). Receiving statuses are reserved for Phase 3 Goods Receipt evidence.
enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

/// Controlled commercial correction on a committed PO (Phase 2.11). Not cancellation/return/short-close.
enum PurchaseCorrectionType {
  DATA_ENTRY_ERROR
  QUANTITY_CORRECTION
  PRICE_CORRECTION
  COMMERCIAL_TERM_CORRECTION
  /// Reserved; supplier change after ORDERED is blocked in normal flow.
  SUPPLIER_CORRECTION
  OTHER

  @@map("purchase_correction_type")
}

/// Corrections are applied immediately and become immutable history.
enum PurchaseCorrectionStatus {
  APPLIED

  @@map("purchase_correction_status")
}

/// Purchasing-side quantity / quality discrepancy (Phase 2.11). Physical evidence is Warehouse (Phase 3).
enum PurchaseDiscrepancyType {
  SHORT_SHIPMENT
  OVER_SHIPMENT
  DAMAGED
  WRONG_ITEM
  MISSING
  OTHER

  @@map("purchase_discrepancy_type")
}

enum PurchaseDiscrepancySource {
  BEFORE_RECEIPT
  AT_RECEIPT
  AFTER_RECEIPT

  @@map("purchase_discrepancy_source")
}

enum PurchaseDiscrepancyStatus {
  OPEN
  RESOLVED
  /// Remaining expected quantity intentionally closed (does not rewrite ordered quantity).
  SHORT_CLOSED

  @@map("purchase_discrepancy_status")
}

/// Commercial return intent (Phase 2.11). Physical stock exit is Warehouse (Phase 3).
enum PurchaseReturnStatus {
  DRAFT
  APPROVED
  CANCELLED

  @@map("purchase_return_status")
}

enum PurchaseReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  OVER_SHIPMENT
  QUALITY_ISSUE
  EXPIRED
  SUPPLIER_AGREEMENT
  OTHER

  @@map("purchase_return_reason")
}

/// Expected commercial resolution — not Finance execution.
enum PurchaseReturnResolution {
  REFUND
  SUPPLIER_CREDIT
  REPLACEMENT
  PAYABLE_REDUCTION
  UNKNOWN

  @@map("purchase_return_resolution")
}

enum CurrencyCode {

// ---------------------------------------------------------------------------
// Phase 4.4 — Supplier Payables
// Liability ledger is truth. Outstanding always derived. Cash does NOT move on recognition.
// ---------------------------------------------------------------------------

model SupplierPayableSequence {
  companyId String @id @map("company_id") @db.Uuid
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("supplier_payable_sequences")
}

model SupplierCreditSequence {
  companyId String @id @map("company_id") @db.Uuid
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("supplier_credit_sequences")
}

model SupplierPayable {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String                      @map("company_id") @db.Uuid
  number                   String
  supplierId               String                      @map("supplier_id") @db.Uuid
  /// Null for OPENING balances — never invent a fake PO.
  purchaseOrderId          String?                     @map("purchase_order_id") @db.Uuid
  purchaseType             SupplierPayablePurchaseType @map("purchase_type")
  /// Contractual obligation currency (FX_CREDIT stays foreign).
  currency                 CurrencyCode
  referenceFxRate          Decimal?                    @map("reference_fx_rate") @db.Decimal(24, 8)
  referenceFxBaseCurrency  CurrencyCode?               @map("reference_fx_base_currency")
  referenceFxQuoteCurrency CurrencyCode?               @map("reference_fx_quote_currency")
  dueDate                  DateTime?                   @map("due_date") @db.Timestamptz(3)
  status                   SupplierPayableStatus       @default(OPEN)
  recognizedAt             DateTime                    @map("recognized_at") @db.Timestamptz(3)
  notes                    String?
  reference                String?
  requestId                String?                     @map("request_id") @db.Uuid
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier     Supplier                  @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  purchaseOrder PurchaseOrder?           @relation(fields: [purchaseOrderId, companyId], references: [id, companyId], onDelete: Restrict)
  lines        SupplierPayableLine[]
  movements    SupplierLiabilityMovement[]
  credits      SupplierCredit[]
  allocations  SupplierPaymentAllocation[]

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, supplierId, currency])
  @@index([companyId, dueDate])
  @@index([companyId, requestId])
  @@map("supplier_payables")
}

model SupplierPayableLine {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String       @map("company_id") @db.Uuid
  payableId           String       @map("payable_id") @db.Uuid
  goodsReceiptId      String       @map("goods_receipt_id") @db.Uuid
  goodsReceiptItemId  String       @map("goods_receipt_item_id") @db.Uuid
  purchaseOrderItemId String       @map("purchase_order_item_id") @db.Uuid
  skuId               String?      @map("sku_id") @db.Uuid
  quantity            Int
  unitPrice           Decimal      @map("unit_price") @db.Decimal(24, 6)
  lineAmount          Decimal      @map("line_amount") @db.Decimal(24, 6)
  currency            CurrencyCode
  recognizedAt        DateTime     @map("recognized_at") @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payable           SupplierPayable   @relation(fields: [payableId, companyId], references: [id, companyId], onDelete: Restrict)
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId, companyId], references: [id, companyId], onDelete: Restrict)
  goodsReceiptItem  GoodsReceiptItem  @relation(fields: [goodsReceiptItemId, companyId], references: [id, companyId], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([goodsReceiptItemId, companyId])
  @@index([companyId, payableId])
  @@index([companyId, goodsReceiptId])
  @@map("supplier_payable_lines")
}

model SupplierLiabilityMovement {
  id               String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String                             @map("company_id") @db.Uuid
  payableId        String?                            @map("payable_id") @db.Uuid
  supplierId       String                             @map("supplier_id") @db.Uuid
  direction        SupplierLiabilityMovementDirection
  type             SupplierLiabilityMovementType
  amount           Decimal                            @db.Decimal(24, 6)
  currency         CurrencyCode
  sourceType       String                             @map("source_type")
  sourceId         String                             @map("source_id") @db.Uuid
  supplierCreditId String?                            @map("supplier_credit_id") @db.Uuid
  effectiveAt      DateTime                           @map("effective_at") @db.Timestamptz(3)
  notes            String?
  requestId        String?                            @map("request_id") @db.Uuid
  createdById      String                             @map("created_by_id") @db.Uuid
  createdAt        DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payable        SupplierPayable? @relation(fields: [payableId, companyId], references: [id, companyId], onDelete: Restrict)
  supplier       Supplier         @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  supplierCredit SupplierCredit?  @relation(fields: [supplierCreditId, companyId], references: [id, companyId], onDelete: Restrict)

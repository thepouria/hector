// Hector foundation schema — Phase 0.2
// Naming: Prisma camelCase models/fields; PostgreSQL snake_case via @@map/@map.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  runtime       = "nodejs"
  moduleFormat  = "cjs"
  // Empty extension keeps Nest/CommonJS require resolution simple after tsc emit.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED

  @@map("company_status")
}

enum CompanyMemberStatus {
  ACTIVE
  SUSPENDED
  /// Access removed while preserving historical membership identity.
  REMOVED

  @@map("company_member_status")
}

/// Company base currency only. Full multi-currency finance belongs to a later phase.
/// Purchase Order lifecycle (Phase 2.4). Receiving/closed states arrive with Warehouse (later phases).
/// Purchase Order lifecycle (Phase 2.9). Receiving statuses are reserved for Phase 3 Goods Receipt evidence.
enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

/// Controlled commercial correction on a committed PO (Phase 2.11). Not cancellation/return/short-close.
enum PurchaseCorrectionType {
  DATA_ENTRY_ERROR
  QUANTITY_CORRECTION
  PRICE_CORRECTION
  COMMERCIAL_TERM_CORRECTION
  /// Reserved; supplier change after ORDERED is blocked in normal flow.
  SUPPLIER_CORRECTION
  OTHER

  @@map("purchase_correction_type")
}

/// Corrections are applied immediately and become immutable history.
enum PurchaseCorrectionStatus {
  APPLIED

  @@map("purchase_correction_status")
}

/// Purchasing-side quantity / quality discrepancy (Phase 2.11). Physical evidence is Warehouse (Phase 3).
enum PurchaseDiscrepancyType {
  SHORT_SHIPMENT
  OVER_SHIPMENT
  DAMAGED
  WRONG_ITEM
  MISSING
  OTHER

  @@map("purchase_discrepancy_type")
}

enum PurchaseDiscrepancySource {
  BEFORE_RECEIPT
  AT_RECEIPT
  AFTER_RECEIPT

  @@map("purchase_discrepancy_source")
}

enum PurchaseDiscrepancyStatus {
  OPEN
  RESOLVED
  /// Remaining expected quantity intentionally closed (does not rewrite ordered quantity).
  SHORT_CLOSED

  @@map("purchase_discrepancy_status")
}

/// Commercial return intent (Phase 2.11). Physical stock exit is Warehouse (Phase 3).
enum PurchaseReturnStatus {
  DRAFT
  APPROVED
  CANCELLED

  @@map("purchase_return_status")
}

enum PurchaseReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  OVER_SHIPMENT
  QUALITY_ISSUE
  EXPIRED
  SUPPLIER_AGREEMENT
  OTHER

  @@map("purchase_return_reason")
}

/// Expected commercial resolution — not Finance execution.
enum PurchaseReturnResolution {
  REFUND
  SUPPLIER_CREDIT
  REPLACEMENT
  PAYABLE_REDUCTION
  UNKNOWN

  @@map("purchase_return_resolution")
}

enum CurrencyCode {
  IRR
  USD

  @@map("currency_code")
}

/// Phase 4.2 — Financial account kinds (where money sits). Not Chart of Accounts.
enum FinancialAccountType {
  CASH
  BANK
  WALLET
  OTHER

  @@map("financial_account_type")
}

enum FinancialAccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("financial_account_status")
}

enum FinancialAccountMovementDirection {
  IN
  OUT

  @@map("financial_account_movement_direction")
}

/// Operational movement kinds. Economic meaning lives on source documents.
enum FinancialAccountMovementType {
  OPENING_BALANCE
  MONEY_IN
  MONEY_OUT
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL

  @@map("financial_account_movement_type")
}

enum FinancialAccountTransferStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED

  @@map("financial_account_transfer_status")
}

enum CapitalContributionStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED

  @@map("capital_contribution_status")
}

/// Equity / other funding only — LOAN is a separate entity (never this enum).
enum CapitalFundingType {
  OWNER_EQUITY
  PARTNER_EQUITY
  OTHER_FUNDING

  @@map("capital_funding_type")
}

enum LoanStatus {
  DRAFT
  ACTIVE
  PARTIALLY_REPAID
  SETTLED
  CANCELLED
  REVERSED

  @@map("loan_status")
}

enum LoanDisbursementStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED

  @@map("loan_disbursement_status")
}

enum LoanRepaymentStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED

  @@map("loan_repayment_status")
}

/// Lightweight counterparty classification for capital / loans (not a Person master).
enum FinanceCounterpartyType {
  MEMBER
  PARTNER
  EXTERNAL_PERSON
  SUPPLIER
  OTHER

  @@map("finance_counterparty_type")
}

/// Phase 4.4 — Supplier payable lifecycle (derived from outstanding; stored for query).
enum SupplierPayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("supplier_payable_status")
}

/// Snapshot of commercial purchase mode at recognition (+ OPENING for opening balances).
enum SupplierPayablePurchaseType {
  CASH
  TERM_CREDIT
  FX_CREDIT
  OPENING

  @@map("supplier_payable_purchase_type")
}

/// Phase 4.5 — FX rate semantic kinds (REFERENCE ≠ CONVERSION ≠ SETTLEMENT ≠ VALUATION).
enum FxRateType {
  REFERENCE
  CONVERSION
  SETTLEMENT
  VALUATION

  @@map("fx_rate_type")
}

enum FxRateSourceType {
  MANUAL
  PURCHASE
  FX_TRANSACTION
  SETTLEMENT
  SYSTEM
  EXTERNAL

  @@map("fx_rate_source_type")
}

enum FxConversionStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED

  @@map("fx_conversion_status")
}

/// Phase 4.6 — standalone money-out document (does not settle SupplierPayable).
enum PaymentStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED

  @@map("payment_status")
}

enum ReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED

  @@map("receipt_status")
}

enum PaymentPurposeType {
  SUPPLIER
  LOAN
  EXPENSE
  REFUND
  CAPITAL_WITHDRAWAL
  OTHER

  @@map("payment_purpose_type")
}

enum ReceiptSourceType {
  CAPITAL
  LOAN
  CUSTOMER
  REFUND
  OTHER

  @@map("receipt_source_type")
}

enum SupplierLiabilityMovementDirection {
  INCREASE
  DECREASE

  @@map("supplier_liability_movement_direction")
}

enum SupplierLiabilityMovementType {
  PURCHASE_RECOGNITION
  PURCHASE_CORRECTION
  SUPPLIER_RETURN
  PAYMENT_ALLOCATION
  OPENING_BALANCE
  REVERSAL
  SUPPLIER_CREDIT

  @@map("supplier_liability_movement_type")
}

enum SupplierCreditStatus {
  OPEN
  APPLIED
  CANCELLED

  @@map("supplier_credit_status")
}

/// Foundation for Phase 4.6 — allocation rows only (no cash yet).
enum SupplierPaymentAllocationStatus {
  POSTED

  @@map("supplier_payment_allocation_status")
}

/// Lifecycle for Catalog Product / SKU / Brand / Category.
/// Archive retains identity for future Purchases / Inventory / Sales references.
enum CatalogLifecycleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("catalog_lifecycle_status")
}

/// Warehouse barcode taxonomy. EAN/UPC require checksum validation; OTHER skips format checks.
enum BarcodeType {
  EAN13
  EAN8
  UPC_A
  CODE128
  INTERNAL
  OTHER

  @@map("barcode_type")
}

/// Typed Product/SKU specification attribute (Phase 1.6). Values are ALWAYS optional.
enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT

  @@map("attribute_type")
}

/// Catalog bulk command lifecycle (Phase 1.10). Sync execution today; future queue workers reuse the same statuses.
enum BulkOperationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED

  @@map("bulk_operation_status")
}

/// Lifecycle for Purchasing Supplier (and future purchasing masters).
/// Archive retains identity for historical PO / Offer references.
enum PurchasingLifecycleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("purchasing_lifecycle_status")
}

/// Warehouse Master lifecycle (Phase 3.2).
/// INACTIVE retains identity for future Locations / Receipts / Movements.
/// No ARCHIVED — deactivation is the non-destructive retire path.
enum WarehouseStatus {
  ACTIVE
  INACTIVE

  @@map("warehouse_status")
}

/// Physical hierarchy metadata for WarehouseLocation (Phase 3.3).
/// Levels may be skipped — type does not mandate a fixed ZONE→…→BIN chain.
enum WarehouseLocationType {
  ZONE
  AISLE
  RACK
  SHELF
  BIN
  /// System-managed in-transit inventory position (Phase 3.11). Not a user shelf.
  TRANSIT

  @@map("warehouse_location_type")
}

/// Internal stock transfer lifecycle (Phase 3.11).
/// DRAFT = planned, no movements. IN_TRANSIT = left source, in transit position.
/// COMPLETED = received at destination. CANCELLED = abandoned (IN_TRANSIT returns to source).
enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED

  @@map("stock_transfer_status")
}

/// Goods Receipt lifecycle (Phase 3.4).
/// DRAFT = editable, does not affect PO received totals.
/// POSTED = physical receipt fact (immutable operational quantities).
/// CANCELLED = abandoned draft only (POSTED cannot cancel in 3.4).
enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED

  @@map("goods_receipt_status")
}

/// Putaway session lifecycle (Phase 3.8).
/// DRAFT / IN_PROGRESS = working placement (not inventory).
/// COMPLETED = immutable historical placement truth (not current stock).
/// CANCELLED = abandoned before completion.
enum PutawayStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("putaway_status")
}

/// Operational inventory classification (Phase 3.12).
/// Position dimension — same SKU/Batch/Location may hold multiple classifications.
enum StockClassification {
  SELLABLE
  TESTER
  DAMAGED
  QUARANTINE

  @@map("stock_classification")
}

/// Manual non-sales outbound reason (Phase 3.12 StockIssue).
enum StockIssueReason {
  COMPANY_USE
  SAMPLE
  DAMAGE
  MANUAL
  OTHER

  @@map("stock_issue_reason")
}

/// StockIssue lifecycle (Phase 3.12).
enum StockIssueStatus {
  DRAFT
  POSTED
  CANCELLED

  @@map("stock_issue_status")
}

/// Manual inventory adjustment reason (Phase 3.13). Not a substitute for Issue/Transfer/Reclass.
enum InventoryAdjustmentReason {
  FOUND
  MISSING
  REGISTRATION_ERROR
  CORRECTION
  OTHER

  @@map("inventory_adjustment_reason")
}

/// InventoryAdjustment lifecycle (Phase 3.13).
enum InventoryAdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
  CANCELLED

  @@map("inventory_adjustment_status")
}

/// Signed direction for adjustment lines. Quantity itself remains positive.
enum InventoryAdjustmentDirection {
  IN
  OUT

  @@map("inventory_adjustment_direction")
}

/// Stock count type (Phase 3.13).
enum StockCountType {
  FULL
  CYCLE

  @@map("stock_count_type")
}

/// StockCount lifecycle (Phase 3.13).
enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  RECOUNT_REQUIRED
  APPROVED
  POSTED
  REJECTED
  CANCELLED

  @@map("stock_count_status")
}

/// Per-line count progress (Phase 3.13).
enum StockCountLineStatus {
  PENDING
  COUNTED
  SKIPPED
  RECOUNT_REQUIRED

  @@map("stock_count_line_status")
}

/// Warehouse physical execution of an approved PurchaseReturn (Phase 3.14).
/// DRAFT has no Ledger effect. DISPATCHED posts RETURN_OUT. No READY state —
/// allocation is edited in DRAFT; dispatch is the sole inventory-critical command.
enum SupplierReturnExecutionStatus {
  DRAFT
  DISPATCHED
  CANCELLED

  @@map("supplier_return_execution_status")
}

/// Append-only inventory ledger movement types (Phase 3.9+).
/// Sign of quantityDelta must agree with type (enforced in SQL + posting service).
enum InventoryMovementType {
  RECEIVE
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  RECLASSIFY_OUT
  RECLASSIFY_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  STOCK_COUNT_ADJUSTMENT_IN
  STOCK_COUNT_ADJUSTMENT_OUT
  OPENING_BALANCE
  SYSTEM_CORRECTION

  @@map("inventory_movement_type")
}

/// Business source that caused ledger movement(s). Extensible; not all workflows implemented yet.
enum InventorySourceType {
  PUTAWAY
  MANUAL_ADJUSTMENT
  TRANSFER
  CLASSIFICATION_CHANGE
  STOCK_ISSUE
  SALES_FULFILLMENT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  STOCK_COUNT
  OPENING_BALANCE
  SYSTEM_CORRECTION
  SEED

  @@map("inventory_source_type")
}

/// Reservation lifecycle (Phase 3.15). Only ACTIVE counts toward Reserved.
enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
  CANCELLED

  @@map("inventory_reservation_status")
}

/// Generic commercial/source identity for reservations (Sales entities are future).
enum InventoryReservationSourceType {
  SALES_ORDER
  MARKETPLACE_ORDER
  MANUAL_OPERATION
  OTHER

  @@map("inventory_reservation_source_type")
}

/// How a cost layer entered the warehouse-scoped FIFO pool.
enum InventoryCostLayerSourceType {
  GOODS_RECEIPT
  TRANSFER_IN
  RECLASSIFY_IN
  ADJUSTMENT_IN
  STOCK_COUNT_ADJUSTMENT_IN
  OPENING_BALANCE
  SYSTEM_BOOTSTRAP
  SEED

  @@map("inventory_cost_layer_source_type")
}

/// Acquisition-cost completeness. Never represent unknown cost as confident zero.
enum InventoryValuationStatus {
  VALUED
  PARTIALLY_VALUED
  UNVALUED

  @@map("inventory_valuation_status")
}

/// Why quantity left a cost layer (economic outbound vs provenance move).
enum InventoryLayerConsumptionKind {
  ISSUE
  ADJUSTMENT_OUT
  STOCK_COUNT_ADJUSTMENT_OUT
  RETURN_OUT
  TRANSFER_OUT
  RECLASSIFY_OUT

  @@map("inventory_layer_consumption_kind")
}

/// Commercial mode quoted by a supplier (and later used on Purchase Orders).
enum PurchaseCommercialType {
  CASH
  TERM_CREDIT
  FX_CREDIT

  @@map("purchase_commercial_type")
}

/// Payment term shape for quotes / future POs. Quote stage usually uses IMMEDIATE or NET_DAYS.
enum PaymentTermType {
  IMMEDIATE
  NET_DAYS
  FIXED_DATE

  @@map("payment_term_type")
}

/// Calendar basis for NET_DAYS → dueDate. Extensible later (INVOICE_DATE, RECEIPT_DATE).
enum PurchaseTermBasis {
  ORDER_DATE

  @@map("purchase_term_basis")
}

/// Commercial acquisition cost type on a Purchase Order (Phase 2.8). Not payment state.
enum PurchaseCostType {
  COURIER
  FREIGHT
  PURCHASE_FEE
  TRANSFER_FEE
  PACKAGING
  CUSTOMS
  OTHER

  @@map("purchase_cost_type")
}

/// ACTIVE costs aggregate; VOIDED rows remain for history (append-oriented corrections).
enum PurchaseCostStatus {
  ACTIVE
  VOIDED

  @@map("purchase_cost_status")
}

/// Future landed-cost allocation intent. Phase 2.8 stores UNALLOCATED only in practice.
enum PurchaseCostAllocationMethod {
  UNALLOCATED
  BY_QUANTITY
  BY_VALUE
  MANUAL

  @@map("purchase_cost_allocation_method")
}

/// Where an AttributeDefinition may be used. Never means "required".
enum AttributeScope {
  PRODUCT
  SKU
  BOTH

  @@map("attribute_scope")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @map("email")
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)

  sessions         Session[]
  memberships      CompanyMember[]
  auditLogsAsActor AuditLog[]      @relation("AuditLogActor")
  supplierNotes    SupplierNote[]
  supplierOffers   SupplierOffer[]
  purchaseOrdersCreated   PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved  PurchaseOrder[] @relation("PurchaseOrderApprovedBy")
  purchaseOrdersOrdered   PurchaseOrder[] @relation("PurchaseOrderOrderedBy")
  purchaseOrdersCancelled PurchaseOrder[] @relation("PurchaseOrderCancelledBy")
  purchaseOrderCostsCreated PurchaseOrderCost[] @relation("PurchaseOrderCostCreatedBy")
  purchaseOrderCostsVoided  PurchaseOrderCost[] @relation("PurchaseOrderCostVoidedBy")
  purchaseOrderCorrectionsApplied PurchaseOrderCorrection[] @relation("PurchaseOrderCorrectionAppliedBy")
  purchaseDiscrepanciesCreated    PurchaseDiscrepancy[]     @relation("PurchaseDiscrepancyCreatedBy")
  purchaseDiscrepanciesResolved   PurchaseDiscrepancy[]     @relation("PurchaseDiscrepancyResolvedBy")
  purchaseReturnsCreated          PurchaseReturn[]          @relation("PurchaseReturnCreatedBy")
  purchaseReturnsApproved         PurchaseReturn[]          @relation("PurchaseReturnApprovedBy")
  purchaseReturnsCancelled        PurchaseReturn[]          @relation("PurchaseReturnCancelledBy")
  goodsReceiptsCreated            GoodsReceipt[]            @relation("GoodsReceiptCreatedBy")
  goodsReceiptsPosted             GoodsReceipt[]            @relation("GoodsReceiptPostedBy")
  goodsReceiptsCancelled          GoodsReceipt[]            @relation("GoodsReceiptCancelledBy")
  putawaysCreated                 Putaway[]                 @relation("PutawayCreatedBy")
  putawaysCompleted               Putaway[]                 @relation("PutawayCompletedBy")
  inventoryMovementsCreated       InventoryMovement[]       @relation("InventoryMovementCreatedBy")
  stockTransfersCreated           StockTransfer[]           @relation("StockTransferCreatedBy")
  stockTransfersDispatched        StockTransfer[]           @relation("StockTransferDispatchedBy")
  stockTransfersCompleted         StockTransfer[]           @relation("StockTransferCompletedBy")
  stockTransfersCancelled         StockTransfer[]           @relation("StockTransferCancelledBy")
  stockClassificationChangesCreated StockClassificationChange[] @relation("StockClassificationChangeCreatedBy")
  stockIssuesCreated              StockIssue[]              @relation("StockIssueCreatedBy")
  stockIssuesPosted               StockIssue[]              @relation("StockIssuePostedBy")
  stockIssuesCancelled            StockIssue[]              @relation("StockIssueCancelledBy")
  inventoryAdjustmentsCreated     InventoryAdjustment[]     @relation("InventoryAdjustmentCreatedBy")
  inventoryAdjustmentsApproved    InventoryAdjustment[]     @relation("InventoryAdjustmentApprovedBy")
  inventoryAdjustmentsRejected    InventoryAdjustment[]     @relation("InventoryAdjustmentRejectedBy")
  inventoryAdjustmentsPosted      InventoryAdjustment[]     @relation("InventoryAdjustmentPostedBy")
  inventoryAdjustmentsCancelled   InventoryAdjustment[]     @relation("InventoryAdjustmentCancelledBy")
  stockCountsCreated              StockCount[]              @relation("StockCountCreatedBy")
  stockCountsStarted              StockCount[]              @relation("StockCountStartedBy")
  stockCountsSubmitted            StockCount[]              @relation("StockCountSubmittedBy")
  stockCountsApproved             StockCount[]              @relation("StockCountApprovedBy")
  stockCountsRejected             StockCount[]              @relation("StockCountRejectedBy")
  stockCountsPosted               StockCount[]              @relation("StockCountPostedBy")
  stockCountsCancelled            StockCount[]              @relation("StockCountCancelledBy")
  stockCountItemsCounted          StockCountItem[]          @relation("StockCountItemCountedBy")
  supplierReturnExecutionsCreated    SupplierReturnExecution[] @relation("SupplierReturnExecutionCreatedBy")
  supplierReturnExecutionsDispatched SupplierReturnExecution[] @relation("SupplierReturnExecutionDispatchedBy")
  supplierReturnExecutionsCancelled  SupplierReturnExecution[] @relation("SupplierReturnExecutionCancelledBy")
  inventoryReservationsCreated       InventoryReservation[]    @relation("InventoryReservationCreatedBy")
  financialAccountsCreated           FinancialAccount[]        @relation("FinancialAccountCreatedBy")
  financialAccountMovementsCreated   FinancialAccountMovement[] @relation("FinancialAccountMovementCreatedBy")
  financialAccountTransfersCreated   FinancialAccountTransfer[] @relation("FinancialAccountTransferCreatedBy")
  financialAccountTransfersPosted    FinancialAccountTransfer[] @relation("FinancialAccountTransferPostedBy")
  financialAccountTransfersCancelled FinancialAccountTransfer[] @relation("FinancialAccountTransferCancelledBy")
  financialAccountTransfersReversed  FinancialAccountTransfer[] @relation("FinancialAccountTransferReversedBy")
  capitalContributionsCreated        CapitalContribution[]     @relation("CapitalContributionCreatedBy")
  capitalContributionsPosted         CapitalContribution[]     @relation("CapitalContributionPostedBy")
  capitalContributionsCancelled      CapitalContribution[]     @relation("CapitalContributionCancelledBy")
  capitalContributionsReversed       CapitalContribution[]     @relation("CapitalContributionReversedBy")
  loansCreated                       Loan[]                    @relation("LoanCreatedBy")
  loansPosted                        Loan[]                    @relation("LoanPostedBy")
  loansCancelled                     Loan[]                    @relation("LoanCancelledBy")
  loansReversed                      Loan[]                    @relation("LoanReversedBy")
  loanDisbursementsCreated           LoanDisbursement[]        @relation("LoanDisbursementCreatedBy")
  loanDisbursementsPosted            LoanDisbursement[]        @relation("LoanDisbursementPostedBy")
  loanDisbursementsCancelled         LoanDisbursement[]        @relation("LoanDisbursementCancelledBy")
  loanDisbursementsReversed          LoanDisbursement[]        @relation("LoanDisbursementReversedBy")
  loanRepaymentsCreated              LoanRepayment[]           @relation("LoanRepaymentCreatedBy")
  loanRepaymentsPosted               LoanRepayment[]           @relation("LoanRepaymentPostedBy")
  loanRepaymentsCancelled            LoanRepayment[]           @relation("LoanRepaymentCancelledBy")
  loanRepaymentsReversed             LoanRepayment[]           @relation("LoanRepaymentReversedBy")
  supplierLiabilityMovementsCreated  SupplierLiabilityMovement[] @relation("SupplierLiabilityMovementCreatedBy")
  supplierPaymentAllocationsCreated  SupplierPaymentAllocation[] @relation("SupplierPaymentAllocationCreatedBy")
  fxRatesCreated                     FxRate[]                    @relation("FxRateCreatedBy")
  fxConversionsCreated               FxConversion[]              @relation("FxConversionCreatedBy")
  fxConversionsPosted                FxConversion[]              @relation("FxConversionPostedBy")
  fxConversionsCancelled             FxConversion[]              @relation("FxConversionCancelledBy")
  fxConversionsReversed              FxConversion[]              @relation("FxConversionReversedBy")
  paymentsCreated                    Payment[]                   @relation("PaymentCreatedBy")
  paymentsPosted                     Payment[]                   @relation("PaymentPostedBy")
  paymentsCancelled                  Payment[]                   @relation("PaymentCancelledBy")
  paymentsReversed                   Payment[]                   @relation("PaymentReversedBy")
  receiptsCreated                    Receipt[]                   @relation("ReceiptCreatedBy")
  receiptsPosted                     Receipt[]                   @relation("ReceiptPostedBy")
  receiptsCancelled                  Receipt[]                   @relation("ReceiptCancelledBy")
  receiptsReversed                   Receipt[]                   @relation("ReceiptReversedBy")

  @@index([status])
  @@map("users")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Companies & membership
// ---------------------------------------------------------------------------

model Company {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String        @unique
  baseCurrency CurrencyCode  @map("base_currency")
  timezone     String
  status       CompanyStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(3)

  members    CompanyMember[]
  roles      Role[]
  auditLogs  AuditLog[]
  brands     Brand[]
  categories Category[]
  products   Product[]
  skus       Sku[]
  barcodes   Barcode[]
  variantOptions      VariantOption[]
  variantOptionValues VariantOptionValue[]
  skuOptionValues     SkuOptionValue[]
  attributeDefinitions        AttributeDefinition[]
  attributeOptions            AttributeOption[]
  categoryAttributes          CategoryAttribute[]

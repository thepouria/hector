# Disposable shared-host smoke — NOT production.
# Project: hector-smoke-shared (never "hector" production).

DEPLOYMENT_MODE=shared-host
HECTOR_COMPOSE_PROJECT=hector-smoke-shared

HECTOR_IMAGE_TAG=smoke-local
HECTOR_API_IMAGE=hector-api:smoke-local
HECTOR_WEB_IMAGE=hector-web:smoke-local
HECTOR_MIGRATE_IMAGE=hector-api-migrate:smoke-local

HECTOR_WEB_DOMAIN=hector.pishete.com
HECTOR_API_DOMAIN=core-hector.pishete.com
HECTOR_WEB_PUBLIC_URL=https://hector.pishete.com
HECTOR_API_PUBLIC_URL=https://core-hector.pishete.com
NEXT_PUBLIC_API_URL=https://core-hector.pishete.com

# High ports avoid collisions with local services and proposed 3100/3101.
HECTOR_WEB_BIND_IP=127.0.0.1
HECTOR_WEB_HOST_PORT=13100
HECTOR_API_BIND_IP=127.0.0.1
HECTOR_API_HOST_PORT=13101

HECTOR_API_MEM_LIMIT=512m
HECTOR_WEB_MEM_LIMIT=512m
HECTOR_POSTGRES_MEM_LIMIT=512m
HECTOR_API_CPUS=0.50
HECTOR_WEB_CPUS=0.50
HECTOR_POSTGRES_CPUS=0.50

NODE_ENV=production
TZ=UTC
API_PORT=3001
WEB_PORT=3000
CORS_ORIGINS=https://hector.pishete.com
SWAGGER_ENABLED=false
LOG_LEVEL=info

JWT_ACCESS_SECRET=K7mP9qR2sT4uV6wX8yZ0aB1cD3eF5gH7iJ9kL0mN2oP4qR6sT8uV0wX=

model SupplierCredit {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  number         String
  supplierId     String               @map("supplier_id") @db.Uuid
  currency       CurrencyCode
  originalAmount Decimal              @map("original_amount") @db.Decimal(24, 6)
  status         SupplierCreditStatus @default(OPEN)
  sourceType     String               @map("source_type")
  sourceId       String               @map("source_id") @db.Uuid
  payableId      String?              @map("payable_id") @db.Uuid
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier  Supplier                    @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  payable   SupplierPayable?            @relation(fields: [payableId, companyId], references: [id, companyId], onDelete: Restrict)
  movements SupplierLiabilityMovement[]

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@unique([companyId, sourceType, sourceId])
  @@index([companyId, supplierId, status])
  @@map("supplier_credits")
}

/// Explicit Payment ↔ SupplierPayable settlement (FIN-SET-002). Soft paymentSource* retained for legacy.
model SupplierPaymentAllocation {
  id                           String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                    String                          @map("company_id") @db.Uuid
  payableId                    String                          @map("payable_id") @db.Uuid
  /// Liability-currency amount settled (canonical decrease).
  amount                       Decimal                         @db.Decimal(24, 6)
  currency                     CurrencyCode
  /// Hard FK to POSTED Payment (nullable for legacy liability-only admin allocations).
  paymentId                    String?                         @map("payment_id") @db.Uuid
  /// Legacy soft link (Phase 4.4/4.6 foundation). Prefer paymentId.
  paymentSourceType            String?                         @map("payment_source_type")
  paymentSourceId              String?                         @map("payment_source_id") @db.Uuid
  paymentCurrency              CurrencyCode                    @map("payment_currency")
  paymentAmountApplied         Decimal                         @map("payment_amount_applied") @db.Decimal(24, 6)
  liabilityAmountSettled       Decimal                         @map("liability_amount_settled") @db.Decimal(24, 6)
  settlementRate               Decimal?                        @map("settlement_rate") @db.Decimal(24, 8)
  settlementRateBaseCurrency   CurrencyCode?                   @map("settlement_rate_base_currency")
  settlementRateQuoteCurrency  CurrencyCode?                   @map("settlement_rate_quote_currency")
  settlementFxRateId           String?                         @map("settlement_fx_rate_id") @db.Uuid
  baseCarryingAmount           Decimal?                        @map("base_carrying_amount") @db.Decimal(24, 6)
  basePaymentAmount            Decimal?                        @map("base_payment_amount") @db.Decimal(24, 6)
  /// paymentBase − carryingBase (positive → FX loss; negative → FX gain).
  fxDifferenceBase             Decimal?                        @map("fx_difference_base") @db.Decimal(24, 6)
  /// Groups multi-liability settle lines from one API call.
  settlementGroupId            String?                         @map("settlement_group_id") @db.Uuid
  requestId                    String?                         @map("request_id") @db.Uuid
  status                       SupplierPaymentAllocationStatus @default(POSTED)
  effectiveAt                  DateTime                        @map("effective_at") @db.Timestamptz(3)
  createdById                  String                          @map("created_by_id") @db.Uuid
  reversedAt                   DateTime?                       @map("reversed_at") @db.Timestamptz(3)
  reversedById                 String?                         @map("reversed_by_id") @db.Uuid
  createdAt                    DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payable          SupplierPayable @relation(fields: [payableId, companyId], references: [id, companyId], onDelete: Restrict)
  payment          Payment?        @relation(fields: [paymentId, companyId], references: [id, companyId], onDelete: Restrict)
  settlementFxRate FxRate?         @relation(fields: [settlementFxRateId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy        User            @relation("SupplierPaymentAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversedBy       User?           @relation("SupplierPaymentAllocationReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, payableId])
  @@index([companyId, paymentId, status])
  @@index([companyId, requestId])
  @@index([companyId, settlementGroupId])
  @@map("supplier_payment_allocations")
}

// ---------------------------------------------------------------------------
// Phase 4.5 — FX + Currency Ledger
// Currency ledger is projected from FxConversion + AccountMovement (no ledger table).
// Valuation never mutates cash / payable / loan. No automatic FX gain/loss journal.
// ---------------------------------------------------------------------------

model FxRate {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  baseCurrency    CurrencyCode     @map("base_currency")
  quoteCurrency   CurrencyCode     @map("quote_currency")
  rate            Decimal          @db.Decimal(24, 8)
  rateType        FxRateType       @map("rate_type")
  sourceType      FxRateSourceType @default(MANUAL) @map("source_type")
  sourceReference String?          @map("source_reference")
  effectiveAt     DateTime         @map("effective_at") @db.Timestamptz(3)
  notes           String?
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdById     String           @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy    User                        @relation("FxRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  conversions  FxConversion[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  settlementAllocationFxDetails SettlementAllocationFxDetail[]

  @@unique([id, companyId])
  @@index([companyId, baseCurrency, quoteCurrency, rateType, effectiveAt(sort: Desc)])
  @@index([companyId, effectiveAt(sort: Desc)])
  @@index([companyId, archivedAt])
  @@map("fx_rates")
}

model FxConversionSequence {
  companyId String @id @map("company_id") @db.Uuid
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("fx_conversion_sequences")
}

model FxConversion {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String             @map("company_id") @db.Uuid
  number               String
  sourceAccountId      String             @map("source_account_id") @db.Uuid
  destinationAccountId String             @map("destination_account_id") @db.Uuid
  fromAmount           Decimal            @map("from_amount") @db.Decimal(24, 6)
  fromCurrency         CurrencyCode       @map("from_currency")
  toAmount             Decimal            @map("to_amount") @db.Decimal(24, 6)
  toCurrency           CurrencyCode       @map("to_currency")
  appliedRate          Decimal            @map("applied_rate") @db.Decimal(24, 8)
  rateBaseCurrency     CurrencyCode       @map("rate_base_currency")
  rateQuoteCurrency    CurrencyCode       @map("rate_quote_currency")
  rateType             FxRateType         @default(CONVERSION) @map("rate_type")
  fxRateId             String?            @map("fx_rate_id") @db.Uuid
  feeAmount            Decimal?           @map("fee_amount") @db.Decimal(24, 6)
  feeCurrency          CurrencyCode?      @map("fee_currency")
  feeAccountId         String?            @map("fee_account_id") @db.Uuid
  status               FxConversionStatus @default(DRAFT)
  effectiveAt          DateTime           @map("effective_at") @db.Timestamptz(3)
  notes                String?
  requestId            String?            @map("request_id") @db.Uuid
  createdById          String             @map("created_by_id") @db.Uuid
  postedAt             DateTime?          @map("posted_at") @db.Timestamptz(3)
  postedById           String?            @map("posted_by_id") @db.Uuid
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?            @map("cancelled_by_id") @db.Uuid
  reversedAt           DateTime?          @map("reversed_at") @db.Timestamptz(3)
  reversedById         String?            @map("reversed_by_id") @db.Uuid
  reversalOfId         String?            @map("reversal_of_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceAccount      FinancialAccount @relation("FxConversionSourceAccount", fields: [sourceAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  destinationAccount FinancialAccount @relation("FxConversionDestinationAccount", fields: [destinationAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  feeAccount         FinancialAccount? @relation("FxConversionFeeAccount", fields: [feeAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  fxRate             FxRate?          @relation(fields: [fxRateId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy          User             @relation("FxConversionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy           User?            @relation("FxConversionPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy        User?            @relation("FxConversionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  reversedBy         User?            @relation("FxConversionReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalOf         FxConversion?    @relation("FxConversionReversal", fields: [reversalOfId, companyId], references: [id, companyId], onDelete: Restrict)
  reversals          FxConversion[]   @relation("FxConversionReversal")

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, sourceAccountId])
  @@index([companyId, destinationAccountId])
  @@index([companyId, fromCurrency, toCurrency])
  @@index([companyId, fxRateId])
  @@index([companyId, reversalOfId])
  @@index([companyId, requestId])
  @@map("fx_conversions")
}

model PaymentSequence {
  companyId String @id @map("company_id") @db.Uuid
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("payment_sequences")
}

/// Standalone money-out. purposeType=SUPPLIER does NOT auto-settle SupplierPayable (FIN-SET-001).
model Payment {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String              @map("company_id") @db.Uuid
  number                String
  accountId             String              @map("account_id") @db.Uuid
  amount                Decimal             @db.Decimal(24, 6)
  currency              CurrencyCode
  status                PaymentStatus       @default(DRAFT)
  effectiveAt           DateTime            @map("effective_at") @db.Timestamptz(3)
  counterpartyType      FinanceCounterpartyType? @map("counterparty_type")
  counterpartyId        String?             @map("counterparty_id") @db.Uuid
  counterpartyName      String?             @map("counterparty_name")
  purposeType           PaymentPurposeType  @map("purpose_type")
  purposeReferenceType  String?             @map("purpose_reference_type")
  purposeReferenceId    String?             @map("purpose_reference_id") @db.Uuid
  reference             String?
  externalReference     String?             @map("external_reference")
  notes                 String?
  requestId             String?             @map("request_id") @db.Uuid
  createdById           String              @map("created_by_id") @db.Uuid
  postedAt              DateTime?           @map("posted_at") @db.Timestamptz(3)
  postedById            String?             @map("posted_by_id") @db.Uuid
  cancelledAt           DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?             @map("cancelled_by_id") @db.Uuid
  reversedAt            DateTime?           @map("reversed_at") @db.Timestamptz(3)
  reversedById          String?             @map("reversed_by_id") @db.Uuid
  reversalOfId          String?             @map("reversal_of_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account     FinancialAccount @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy   User             @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?            @relation("PaymentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User?            @relation("PaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  reversedBy  User?            @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalOf  Payment?         @relation("PaymentReversal", fields: [reversalOfId, companyId], references: [id, companyId], onDelete: Restrict)
  reversals   Payment[]        @relation("PaymentReversal")
  expensePaymentAllocations ExpensePaymentAllocation[]
  purchaseCostPaymentAllocations PurchaseCostPaymentAllocation[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  settlementAllocations SettlementAllocation[]

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, accountId])
  @@index([companyId, purposeType])
  @@index([companyId, currency, createdAt])
  @@index([companyId, reversalOfId])
  @@index([companyId, requestId])
  @@map("payments")
}

model ReceiptSequence {
  companyId String @id @map("company_id") @db.Uuid
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("receipt_sequences")
}

/// Standalone money-in. Does not replace CapitalContribution / LoanDisbursement posting.
model Receipt {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String             @map("company_id") @db.Uuid
  number               String
  accountId            String             @map("account_id") @db.Uuid
  amount               Decimal            @db.Decimal(24, 6)
  currency             CurrencyCode
  status               ReceiptStatus      @default(DRAFT)
  effectiveAt          DateTime           @map("effective_at") @db.Timestamptz(3)
  counterpartyType     FinanceCounterpartyType? @map("counterparty_type")
  counterpartyId       String?            @map("counterparty_id") @db.Uuid
  counterpartyName     String?            @map("counterparty_name")
  sourceType           ReceiptSourceType  @map("source_type")
  sourceReferenceType  String?            @map("source_reference_type")
  sourceReferenceId    String?            @map("source_reference_id") @db.Uuid
  reference            String?
  externalReference    String?            @map("external_reference")
  notes                String?
  requestId            String?            @map("request_id") @db.Uuid
  createdById          String             @map("created_by_id") @db.Uuid
  postedAt             DateTime?          @map("posted_at") @db.Timestamptz(3)
  postedById           String?            @map("posted_by_id") @db.Uuid
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?            @map("cancelled_by_id") @db.Uuid
  reversedAt           DateTime?          @map("reversed_at") @db.Timestamptz(3)
  reversedById         String?            @map("reversed_by_id") @db.Uuid
  reversalOfId         String?            @map("reversal_of_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account     FinancialAccount @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy   User             @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?            @relation("ReceiptPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User?            @relation("ReceiptCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  reversedBy  User?            @relation("ReceiptReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalOf  Receipt?         @relation("ReceiptReversal", fields: [reversalOfId, companyId], references: [id, companyId], onDelete: Restrict)
  reversals   Receipt[]        @relation("ReceiptReversal")
  settlementAllocations SettlementAllocation[]

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, accountId])
  @@index([companyId, sourceType])
  @@index([companyId, currency, createdAt])
  @@index([companyId, reversalOfId])
  @@index([companyId, requestId])
  @@map("receipts")
}

// ---------------------------------------------------------------------------
// Phase 4.7 — Expenses + Purchase Cost financialization
// Expense = economic cost (not cash). Payment allocation settles Expense.
// CAPITALIZABLE purchase costs update FIFO valuation; PERIOD_EXPENSE links Expense.
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String                @map("company_id") @db.Uuid
  code        String
  name        String
  status      ExpenseCategoryStatus @default(ACTIVE)
  description String?
  isSystem    Boolean               @default(false) @map("is_system")
  createdById String?               @map("created_by_id") @db.Uuid
  archivedAt  DateTime?             @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy       User?          @relation("ExpenseCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses        Expense[]
  /// Phase 4.8 — expense P&L ledger account for recognition journals.
  ledgerAccountId String?        @map("ledger_account_id") @db.Uuid
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, ledgerAccountId])
  @@map("expense_categories")
}

model ExpenseSequence {
  companyId String @id @map("company_id") @db.Uuid
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("expense_sequences")
}

model Expense {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String               @map("company_id") @db.Uuid
  number           String
  categoryId       String               @map("category_id") @db.Uuid
  amount           Decimal              @db.Decimal(24, 6)
  currency         CurrencyCode
  expenseDate      DateTime             @map("expense_date") @db.Timestamptz(3)
  dueDate          DateTime?            @map("due_date") @db.Timestamptz(3)
  counterpartyType FinanceCounterpartyType? @map("counterparty_type")
  counterpartyId   String?              @map("counterparty_id") @db.Uuid
  counterpartyName String?              @map("counterparty_name")
  description      String
  reference        String?
  notes            String?
  status           ExpenseStatus        @default(DRAFT)
  paymentStatus    ExpensePaymentStatus @default(UNPAID) @map("payment_status")
  sourceType       ExpenseSourceType    @default(MANUAL) @map("source_type")
  sourceId         String?              @map("source_id") @db.Uuid
  requestId        String?              @map("request_id") @db.Uuid
  createdById      String               @map("created_by_id") @db.Uuid
  approvedAt       DateTime?            @map("approved_at") @db.Timestamptz(3)
  approvedById     String?              @map("approved_by_id") @db.Uuid
  cancelledAt      DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledById    String?              @map("cancelled_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category    ExpenseCategory @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledBy User?           @relation("ExpenseCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  paymentAllocations ExpensePaymentAllocation[]
  purchaseOrderCosts PurchaseOrderCost[]

  @@unique([id, companyId])
  @@unique([companyId, number])
  /// Partial unique (source_id IS NOT NULL) enforced in migration SQL.
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, status, expenseDate])
  @@index([companyId, paymentStatus])
  @@index([companyId, categoryId])
  @@index([companyId, currency, expenseDate])
  @@index([companyId, requestId])
  @@map("expenses")
}

model ExpensePaymentAllocation {
  id          String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String                          @map("company_id") @db.Uuid
  expenseId   String                          @map("expense_id") @db.Uuid
  paymentId   String                          @map("payment_id") @db.Uuid
  amount      Decimal                         @db.Decimal(24, 6)
  currency    CurrencyCode
  status      ExpensePaymentAllocationStatus  @default(ACTIVE)
  requestId   String?                         @map("request_id") @db.Uuid
  createdById String                          @map("created_by_id") @db.Uuid
  reversedAt  DateTime?                       @map("reversed_at") @db.Timestamptz(3)
  reversedById String?                        @map("reversed_by_id") @db.Uuid
  createdAt   DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  expense   Expense  @relation(fields: [expenseId, companyId], references: [id, companyId], onDelete: Restrict)
  payment   Payment  @relation(fields: [paymentId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User     @relation("ExpensePaymentAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversedBy User?   @relation("ExpensePaymentAllocationReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, expenseId, status])
  @@index([companyId, paymentId, status])
  @@index([companyId, requestId])
  @@map("expense_payment_allocations")
}

model PurchaseCostAllocationLine {
  id                 String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String                           @map("company_id") @db.Uuid
  purchaseOrderCostId String                          @map("purchase_order_cost_id") @db.Uuid
  targetType         PurchaseCostAllocationTargetType @map("target_type")
  targetId           String                           @map("target_id") @db.Uuid
  allocatedAmount    Decimal                          @map("allocated_amount") @db.Decimal(24, 6)
  currency           CurrencyCode
  createdById        String                           @map("created_by_id") @db.Uuid

enum InventoryMovementType {
  RECEIVE
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  RECLASSIFY_OUT
  RECLASSIFY_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN

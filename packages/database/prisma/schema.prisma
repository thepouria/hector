// ---------------------------------------------------------------------------
// Phase 4.5 — FX + Currency Ledger
// Currency ledger is projected from FxConversion + AccountMovement (no ledger table).
// Valuation never mutates cash / payable / loan. No automatic FX gain/loss journal.
// ---------------------------------------------------------------------------

model FxRate {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  baseCurrency    CurrencyCode     @map("base_currency")
  quoteCurrency   CurrencyCode     @map("quote_currency")
  rate            Decimal          @db.Decimal(24, 8)
  rateType        FxRateType       @map("rate_type")
  sourceType      FxRateSourceType @default(MANUAL) @map("source_type")
  sourceReference String?          @map("source_reference")
  effectiveAt     DateTime         @map("effective_at") @db.Timestamptz(3)
  notes           String?
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdById     String           @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy    User           @relation("FxRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  conversions  FxConversion[]

  @@unique([id, companyId])
  @@index([companyId, baseCurrency, quoteCurrency, rateType, effectiveAt(sort: Desc)])
  @@index([companyId, effectiveAt(sort: Desc)])
  @@index([companyId, archivedAt])
  @@map("fx_rates")
}

model FxConversionSequence {
  companyId String @id @map("company_id") @db.Uuid
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("fx_conversion_sequences")
}

model FxConversion {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String             @map("company_id") @db.Uuid
  number               String
  sourceAccountId      String             @map("source_account_id") @db.Uuid
  destinationAccountId String             @map("destination_account_id") @db.Uuid
  fromAmount           Decimal            @map("from_amount") @db.Decimal(24, 6)
  fromCurrency         CurrencyCode       @map("from_currency")
  toAmount             Decimal            @map("to_amount") @db.Decimal(24, 6)
  toCurrency           CurrencyCode       @map("to_currency")
  appliedRate          Decimal            @map("applied_rate") @db.Decimal(24, 8)
  rateBaseCurrency     CurrencyCode       @map("rate_base_currency")
  rateQuoteCurrency    CurrencyCode       @map("rate_quote_currency")
  rateType             FxRateType         @default(CONVERSION) @map("rate_type")
  fxRateId             String?            @map("fx_rate_id") @db.Uuid
  feeAmount            Decimal?           @map("fee_amount") @db.Decimal(24, 6)
  feeCurrency          CurrencyCode?      @map("fee_currency")
  feeAccountId         String?            @map("fee_account_id") @db.Uuid
  status               FxConversionStatus @default(DRAFT)
  effectiveAt          DateTime           @map("effective_at") @db.Timestamptz(3)
  notes                String?
  requestId            String?            @map("request_id") @db.Uuid
  createdById          String             @map("created_by_id") @db.Uuid
  postedAt             DateTime?          @map("posted_at") @db.Timestamptz(3)
  postedById           String?            @map("posted_by_id") @db.Uuid
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?            @map("cancelled_by_id") @db.Uuid
  reversedAt           DateTime?          @map("reversed_at") @db.Timestamptz(3)
  reversedById         String?            @map("reversed_by_id") @db.Uuid
  reversalOfId         String?            @map("reversal_of_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceAccount      FinancialAccount @relation("FxConversionSourceAccount", fields: [sourceAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  destinationAccount FinancialAccount @relation("FxConversionDestinationAccount", fields: [destinationAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  feeAccount         FinancialAccount? @relation("FxConversionFeeAccount", fields: [feeAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  fxRate             FxRate?          @relation(fields: [fxRateId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy          User             @relation("FxConversionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy           User?            @relation("FxConversionPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy        User?            @relation("FxConversionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  reversedBy         User?            @relation("FxConversionReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalOf         FxConversion?    @relation("FxConversionReversal", fields: [reversalOfId, companyId], references: [id, companyId], onDelete: Restrict)
  reversals          FxConversion[]   @relation("FxConversionReversal")

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, sourceAccountId])
  @@index([companyId, destinationAccountId])
  @@index([companyId, fromCurrency, toCurrency])
  @@index([companyId, fxRateId])
  @@index([companyId, reversalOfId])
  @@index([companyId, requestId])
  @@map("fx_conversions")
}

model PaymentSequence {
  companyId String @id @map("company_id") @db.Uuid
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("payment_sequences")
}

/// Standalone money-out. purposeType=SUPPLIER does NOT settle SupplierPayable (Phase 4.9).
model Payment {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String              @map("company_id") @db.Uuid
  number                String
  accountId             String              @map("account_id") @db.Uuid
  amount                Decimal             @db.Decimal(24, 6)
  currency              CurrencyCode
  status                PaymentStatus       @default(DRAFT)
  effectiveAt           DateTime            @map("effective_at") @db.Timestamptz(3)
  counterpartyType      FinanceCounterpartyType? @map("counterparty_type")
  counterpartyId        String?             @map("counterparty_id") @db.Uuid
  counterpartyName      String?             @map("counterparty_name")
  purposeType           PaymentPurposeType  @map("purpose_type")
  purposeReferenceType  String?             @map("purpose_reference_type")
  purposeReferenceId    String?             @map("purpose_reference_id") @db.Uuid
  reference             String?
  externalReference     String?             @map("external_reference")
  notes                 String?
  requestId             String?             @map("request_id") @db.Uuid
  createdById           String              @map("created_by_id") @db.Uuid
  postedAt              DateTime?           @map("posted_at") @db.Timestamptz(3)
  postedById            String?             @map("posted_by_id") @db.Uuid
  cancelledAt           DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?             @map("cancelled_by_id") @db.Uuid
  reversedAt            DateTime?           @map("reversed_at") @db.Timestamptz(3)
  reversedById          String?             @map("reversed_by_id") @db.Uuid
  reversalOfId          String?             @map("reversal_of_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account     FinancialAccount @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy   User             @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?            @relation("PaymentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User?            @relation("PaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  reversedBy  User?            @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalOf  Payment?         @relation("PaymentReversal", fields: [reversalOfId, companyId], references: [id, companyId], onDelete: Restrict)
  reversals   Payment[]        @relation("PaymentReversal")

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, accountId])
  @@index([companyId, purposeType])
  @@index([companyId, currency, createdAt])
  @@index([companyId, reversalOfId])
  @@index([companyId, requestId])
  @@map("payments")
}

model ReceiptSequence {
  companyId String @id @map("company_id") @db.Uuid
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("receipt_sequences")
}

/// Standalone money-in. Does not replace CapitalContribution / LoanDisbursement posting.
model Receipt {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String             @map("company_id") @db.Uuid
  number               String
  accountId            String             @map("account_id") @db.Uuid
  amount               Decimal            @db.Decimal(24, 6)
  currency             CurrencyCode
  status               ReceiptStatus      @default(DRAFT)
  effectiveAt          DateTime           @map("effective_at") @db.Timestamptz(3)
  counterpartyType     FinanceCounterpartyType? @map("counterparty_type")
  counterpartyId       String?            @map("counterparty_id") @db.Uuid
  counterpartyName     String?            @map("counterparty_name")
  sourceType           ReceiptSourceType  @map("source_type")
  sourceReferenceType  String?            @map("source_reference_type")
  sourceReferenceId    String?            @map("source_reference_id") @db.Uuid
  reference            String?
  externalReference    String?            @map("external_reference")
  notes                String?
  requestId            String?            @map("request_id") @db.Uuid
  createdById          String             @map("created_by_id") @db.Uuid
  postedAt             DateTime?          @map("posted_at") @db.Timestamptz(3)
  postedById           String?            @map("posted_by_id") @db.Uuid
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?            @map("cancelled_by_id") @db.Uuid
  reversedAt           DateTime?          @map("reversed_at") @db.Timestamptz(3)
  reversedById         String?            @map("reversed_by_id") @db.Uuid
  reversalOfId         String?            @map("reversal_of_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account     FinancialAccount @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy   User             @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?            @relation("ReceiptPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User?            @relation("ReceiptCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  reversedBy  User?            @relation("ReceiptReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalOf  Receipt?         @relation("ReceiptReversal", fields: [reversalOfId, companyId], references: [id, companyId], onDelete: Restrict)
  reversals   Receipt[]        @relation("ReceiptReversal")

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, accountId])
  @@index([companyId, sourceType])
  @@index([companyId, currency, createdAt])
  @@index([companyId, reversalOfId])
  @@index([companyId, requestId])
  @@map("receipts")
}
